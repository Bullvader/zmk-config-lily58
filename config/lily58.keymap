#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -------------------------------------------------------------------------------------------------------------
            // |   ESC    |  1  |  2  |   3   |   4   |   5   |                  |   6   |  7   |  8   |  9   |   0   |   `   |
            // |   TAB    |  Q  |  W  |   E   |   R   |   T   |                  |   Y   |  U   |  I   |  O   |   P   |   -   |
            // | CTRL/ESC |  A  |  S  |   D   |   F   |   G   |                  |   H   |  J   |  K   |  L   |   ;   |   '   |
            // |  SHIFT   |  Z  |  X  |   C   |   V   |   B   | PG_DN |  | PG_UP |   N   |  M   |  ,   |  .   |   /   | SHIFT |
            //                        |  ALT  |  GUI  | LOWER | SPACE |  | ENTER | RAISE | BSPC |  FN  |

            bindings = <
&kp ESC        &kp N1  &kp N2  &kp N3         &kp N4        &kp N5                                    &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp GRAVE
&kp TAB        &kp Q   &kp W   &kp E          &kp R         &kp T                                     &kp Y   &kp U   &kp I      &kp O    &kp P     &kp LEFT_BRACKET
&mt LCTRL ESC  &kp A   &kp S   &kp D          &kp F         &kp G                                     &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT      &kp Z   &kp X   &kp C          &kp V         &kp B         &kp DEL      &kp BACKSPACE  &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_BRACKET
                               &kp BACKSLASH  &kp LEFT_ALT  &kp LEFT_GUI  &kp SPACE    &kp ENTER      &mo 1   &mo 2   &mo 3
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------------
            // | BTCLR |  BT1  |  BT2  |  BT3  |  BT4  |  BT5  |                  |           |         |           |            |       |       |
            // |       |       |       |       |       |       |                  |           |         |           |            |       |       |
            // |       |       |       |       |       |       |                  | SCRL_LEFT | SCRL_UP | SCRL_DOWN | SCRL_RIGHT |       |  "|"  |
            // |       |       |       |       |       |       |       |  |       |           |         |     [     |      ]     |   =   |       |
            //                         |       |  MB4  |       |       |  |  DEL  |           |         |           |

            bindings = <
&trans  &trans          &trans        &trans          &trans           &bt BT_CLR                        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &studio_unlock
&trans  &trans          &trans        &trans          &trans           &trans                            &trans        &trans        &trans        &trans        &trans        &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_UP                      &mkp MB3      &mkp MB1      &mkp MB2      &trans        &trans        &trans
&trans  &trans          &trans        &msc SCRL_LEFT  &msc SCRL_RIGHT  &msc SCRL_DOWN  &trans    &trans  &trans        &trans        &trans        &trans        &trans        &trans
                                      &trans          &trans           &trans          &trans    &trans  &trans        &trans        &trans
            >;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |      |      |      |      |      |      |                  |      |       |       |      |       |       |
            // |      |      |      |      |      |      |                  |      |       |       |      |       |       |
            // |      |      |      |      |      |      |                  |  <-  |   v   |   ^   |  ->  |       |   \   |
            // |      |      |      |      |      |      |       |  |       |      |       |   {   |  }   |   +   |       |
            //                      |      |      |      |       |  |       |      |       |       |

            bindings = <
&kp TILDE  &trans    &trans  &trans    &trans     &trans                          &trans     &trans    &trans     &trans     &trans    &trans
&kp GRAVE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR   &kp PRCNT                       &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR  &trans
&trans     &kp N1    &kp N2  &kp N3    &kp N4     &kp N5                          &kp LEFT   &kp DOWN  &kp UP     &kp RIGHT  &trans    &trans
&trans     &kp N6    &kp N7  &kp N8    &kp N9     &kp N0     &kp UNDER    &trans  &trans     &trans    &trans     &trans     &trans    &trans
                             &trans    &kp MINUS  &kp PLUS   &kp EQUAL    &trans  &trans     &trans    &trans
            >;
        };

        function_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |      |  F1  |  F2  |  F3  |  F4  |  F5  |                  |  F6   |  F7   |  F8  |  F9  |  F10  |       |
            // |      |      |      |      |      |      |                  |  F11  |  F12  |      |      | PSCRN |       |
            // |      | PREV | NEXT |      |      |      |                  |       |       |      |      |       |       |
            // |      | PLAY | MUTE | VOL- | VOL+ |      |       |  |       |       |       |      |      |       |       |
            //                      |      |      |      |       |  |       |       |       |      |

            bindings = <
&trans  &kp F1  &kp F2      &kp F3    &kp F4      &kp F5                              &kp F6   &kp F7   &kp F8  &kp F9  &kp F10    &trans
&trans  &trans  &trans      &trans    &trans      &trans                              &kp F11  &kp F12  &trans  &trans  &kp PSCRN  &trans
&trans  &trans  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp C_VOL_UP                        &trans   &trans   &trans  &trans  &trans     &trans
&trans  &trans  &trans      &trans    &trans      &kp C_VOL_DN  &kp C_MUTE    &trans  &trans   &trans   &trans  &trans  &trans     &trans
                            &trans    &trans      &trans        &trans        &trans  &trans   &trans   &trans
            >;
        };
    };
};
